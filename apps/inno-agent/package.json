{
	"name": "inno-agent",
	"version": "0.7.0",
	"description": "Personal learning agent built on PI SDK with three-layer memory system",
	"type": "module",
	"bin": {
		"inno": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"start": "node dist/cli.js",
		"server": "node dist/server.js",
		"web:dev": "npm --workspace inno-agent-web run dev",
		"web:build": "npm --workspace inno-agent-web run build",
		"auth:migrate": "tsx src/auth/migrate.ts",
		"auth:schema": "tsx src/auth/migrate.ts --print",
		"tenants:legacy": "tsx src/tenants/migrate-legacy.ts"
	},
	"dependencies": {
		"@better-auth/core": "1.7.12",
		"@better-auth/utils": "0.5.0",
		"@better-fetch/fetch": "1.3.2",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@gotgenes/pi-permission-system": "^36.2.0",
		"@injaneity/pi-computer-use": "^0.5.1",
		"@juicesharp/rpiv-ask-user-question": "^2.12.0",
		"@juicesharp/rpiv-todo": "^2.12.0",
		"@larksuiteoapi/node-sdk": "^1.63.1",
		"@llamaindex/liteparse": "^1.3.0",
		"@tavily/core": "^0.7.6",
		"@types/ws": "^8.18.1",
		"better-auth": "1.7.12",
		"cron-parser": "^5.5.0",
		"graphology": "^0.26.0",
		"graphology-communities-louvain": "^2.0.2",
		"jiti": "^2.7.0",
		"node-pty": "^1.0.0",
		"pg": "8.23.1",
		"pi-mcp-adapter": "^5.1.0",
		"pi-sandbox": "0.4.3",
		"pi-subagents": "^0.74.0",
		"pi-web-access": "^0.35.0",
		"pino": "^10.3.1",
		"pino-caller": "^4.0.0",
		"source-map-support": "^0.5.21",
		"typebox": "^1.3.7",
		"undici": "^7.19.1",
		"ws": "^8.21.0",
		"yaml": "^2.6.1"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/pg": "8.16.0",
		"@types/pino": "^7.0.4",
		"graphology-types": "0.24.8"
	}
}
