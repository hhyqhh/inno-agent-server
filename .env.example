INNO_HOME=./runtime
INNO_CONFIG_DIR=./runtime/config
INNO_DATA_DIR=./runtime/data
INNO_SKILLS_DIR=./runtime/skills
INNO_WORKSPACE_DIR=./workspace
INNO_PORT=3000
# Local mode is loopback-only by default. Containers/LAN require both settings;
# the override is intentionally insecure because local mode has no accounts.
# INNO_HOST=0.0.0.0
# INNO_ALLOW_UNAUTHENTICATED_NETWORK=true

# Optional Better Auth + PostgreSQL accounts and tenant-scoped storage.
# Better Auth disables host shell/file tools and PTY terminals. The restricted
# multi-user runtime requires Better Auth and this explicit opt-in; it remains
# single-process and must never run active-active replicas on one data root.
# INNO_MULTI_USER_ENABLED=true
# INNO_AUTH_MODE=better-auth
# DATABASE_URL=postgresql://inno:inno@127.0.0.1:5432/inno
# BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# BETTER_AUTH_URL=http://localhost:3000
# INNO_TRUSTED_ORIGINS=http://localhost:5173
# INNO_AUTH_ALLOW_SIGNUP=true
# Explicit pi-durable new-session API opt-in. Legacy JSONL remains the default;
# durable SQLite is single-process/single-owner, never active-active or NFS-shared.
# INNO_DURABLE_ENABLED=true
# INNO_HOST=0.0.0.0

# Log verbosity for the file logger (default: info)
# LOG_LEVEL=info
# Include truncated LLM request/response bodies in the log (privacy-sensitive:
# prompts, learner profile and model output end up in log/server-*.log).
# Default off — only metadata (URL, status, timing, body sizes) is logged.
# LOG_LLM_BODY=0
